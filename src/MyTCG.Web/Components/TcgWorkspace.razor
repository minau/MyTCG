@using MyTCG.Contracts
@using MyTCG.Client
@using Microsoft.AspNetCore.Components.Web
@inject AuthClient Auth
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.JSInterop
<header>
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span><span>MyTCG</span></a>
<button class="tcg-switcher secondary" disabled="@busy" aria-label="Ouvrir le menu" aria-expanded="@drawer" @onclick="()=>drawer=true">☰ Menu</button>
</header>
<div class="tcg-workspace">
@if(drawer){<div class="drawer-backdrop" @onclick="()=>drawer=false"></div><aside class="tcg-drawer" role="dialog" aria-modal="true" aria-label="Menu principal" tabindex="-1" @ref="drawerElement" @onkeydown="DrawerKey"><button class="secondary" @onclick="()=>drawer=false">Fermer ×</button><h2>Mes TCG</h2>@foreach(var t in mine){<button class="secondary" disabled="@busy" aria-current="@(current?.Id==t.Id?"true":"false")" @onclick="()=>Select(t)">@if(t.CoverImage is {} tcgImage){<img class="switcher-cover" src="@tcgImage" alt="" referrerpolicy="no-referrer" />}else{<span>◇</span>} @t.Name @(t.IsAdmin?"· Administrateur":"") @(current?.Id==t.Id?"✓":"")</button>}@if(mine.Length==0){<p>Vous n’avez rejoint aucun univers.</p>}<h3>Mon Compte</h3><button class="secondary" disabled="@busy" aria-current='@(mode=="account"?"page":null)' @onclick='()=>Action("account")'>Mon Compte</button><h3>Actions</h3><button @onclick='()=>Action("create")'>Créer un TCG</button><button @onclick='()=>Action("join")'>Rejoindre par code</button><button @onclick='()=>Action("discover")'>Parcourir les TCG publics</button></aside>}
@if(error is not null){<p class="notice error" role="alert">@error</p><button class="secondary" @onclick="Reload">Réessayer</button>}
@if(mode=="account"){
@ChildContent
}
else if(loading){<p role="status">Chargement de votre univers…</p>}
else if(mode=="create"){
<section class="panel"><h2>Créer votre univers</h2><label>Nom<input @bind="tcgName" maxlength="100" /></label><label>Description<textarea @bind="tcgDescription"></textarea></label><label>Image de couverture HTTPS<input @bind="cover" /></label><label>Visibilité<select @bind="visibility"><option value="0">Public</option><option value="1">Privé</option></select></label><button @onclick="Create" disabled="@busy">Créer le TCG</button></section>
}else if(mode=="join"){
<section class="panel"><h2>Une invitation à l’aventure</h2><label>Code d’invitation<input @bind="code" /></label><button @onclick="JoinCode" disabled="@busy">Rejoindre</button></section>
}else if(mode=="discover"){
<h2>Explorer les univers</h2><label>Rechercher un TCG<input @bind="publicSearch" /></label><button @onclick="Discover">Rechercher</button><div class="tiles">@foreach(var t in publics){<article class="panel">@if(t.CoverImage is not null){<img class="cover" src="@t.CoverImage" alt="" referrerpolicy="no-referrer" />}<h3>@t.Name</h3><p>@t.Description</p><p>@t.Members membres</p><button disabled="@(busy||mine.Any(x=>x.Id==t.Id))" @onclick="()=>Join(t)">@(mine.Any(x=>x.Id==t.Id)?"Déjà membre":"Rejoindre")</button></article>}</div>@if(publics.Length==0){<p>Aucun univers public trouvé.</p>}
}else if(current is null){<section class="panel"><h2>Votre prochain univers vous attend.</h2><p>Créez un TCG ou rejoignez celui de vos amis.</p><button @onclick='()=>Action("create")'>Créer un TCG</button><button class="secondary" @onclick='()=>Action("discover")'>Explorer les univers</button></section>}
else{
<nav class="tcg-nav" aria-label="Navigation du TCG">@foreach(var item in current.IsAdmin?new[]{"Collection","Boosters","Decks","Combat","Studio"}:new[]{"Collection","Boosters","Decks","Combat"}){<button class="@(tab==item?"selected":"secondary")" aria-current="@(tab==item?"page":null)" @onclick="()=>ChangeTab(item)">@item</button>}</nav>
@if(tab=="Combat"){<section class="panel"><h2>Les prochains défis se préparent.</h2><p>Le combat arrive prochainement.</p></section>}
@if(tab=="Collection"||tab=="Studio"){
@if(tab=="Studio"&&editing){<CardEditor @key="editCard?.Id" TcgId="current.Id" Card="editCard" Saved="CardSaved" Cancel="()=>editing=false" />}
else{
<div class="section-heading"><div><h2>@tab</h2>@if(tab=="Collection"){<p>@progress.Discovered / @progress.Total cartes découvertes — @(progress.Total==0?"0":(100.0*progress.Discovered/progress.Total).ToString("0.0")) % · @progress.Copies exemplaires</p><progress value="@progress.Discovered" max="@Math.Max(1,progress.Total)"></progress>}else{<p>@cards.Length cartes · @string.Join(" · ",Enumerable.Range(0,5).Select(r=>$"{rarities[r]} : {cards.Count(c=>c.Rarity==r)}"))</p><button @onclick="()=>{editCard=null;editing=true;}">Créer une carte</button>@if(current.Visibility==1){<button class="secondary" @onclick="()=>Invitation(false)">Voir le code d’invitation</button><button class="secondary" @onclick="()=>Invitation(true)">Régénérer le code</button>@if(invitation is not null){<p>Code : <code>@invitation</code></p>}}}</div></div>
<div class="filters"><label>Rechercher<input @bind="search" @bind:event="oninput" /></label><label>Rareté<select @bind="rarity"><option value="-1">Toutes</option>@for(var i=0;i<5;i++){<option value="@i">@rarities[i]</option>}</select></label><label>Type<select @bind="type"><option value="-1">Tous</option><option value="0">Personnage</option><option value="1">Action</option></select></label><label>Tri<select @bind="sort"><option value="number">Numéro</option><option value="name">Nom</option><option value="rarity">Rareté</option></select></label>@if(tab=="Collection"){<label><input type="checkbox" @bind="showAll" /> Voir tout le catalogue</label>}</div>
<div class="card-grid">@foreach(var c in Filtered){var quantity=collection.FirstOrDefault(x=>x.Card.Id==c.Id)?.Quantity??0;<div @key="c.Id"><button class="card-button" @onclick="()=>detail=c"><CardView Card="c" Quantity="@(tab=="Collection"?quantity:null)" Locked="@(tab=="Collection"&&quantity==0)" /></button>@if(tab=="Studio"){<button class="secondary" @onclick="()=>{editCard=c;editing=true;}">Modifier</button><button class="secondary" disabled="@busy" @onclick="()=>Status(c)">@(c.IsActive?"Archiver":"Activer")</button>}</div>}</div>@if(!Filtered.Any()){<p class="panel">@(tab=="Studio"?"Aucune carte. Créez la première carte de votre univers.":"Aucune carte à afficher. Ouvrez un booster pour commencer votre collection.")</p>}
}}
@if(tab=="Boosters"){
<section class="panel booster-panel"><p class="eyebrow">@current.Name</p><div class="booster-art" aria-hidden="true">✦<small>MYTCG · 5 CARTES</small></div><h2>@(status.IsUnlimited ? "Boosters illimités" : $"{status.Remaining} / {status.DailyLimit} boosters disponibles")</h2>@if(!status.IsUnlimited){<p>Renouvellement : @status.ResetsAt.ToLocalTime().ToString("dd/MM HH:mm") (heure locale)</p>}<button disabled="@(busy||(!status.IsUnlimited&&status.Remaining==0))" @onclick="Open">@(busy?"Ouverture…":"Ouvrir un booster")</button></section>
@if(opening is not null){<section class="panel"><h2>Votre booster</h2>@if(revealed<5){<button @onclick="()=>revealed++">Révéler la carte @(revealed+1)</button><button class="secondary" @onclick="()=>revealed=5">Passer l’animation</button>}else{<p>Les cinq cartes ont rejoint votre collection.</p>}<div class="card-grid reveal">@for(var i=0;i<revealed;i++){<div class="@(i==4?"fifth-card":"")"><CardView Card="opening.Cards[i]" /></div>}</div></section>}
<details><summary>Historique des ouvertures</summary>@foreach(var o in history){<p>@o.OpenedAt.ToLocalTime().ToString("g") — @string.Join(", ",o.Cards.Select(c=>c.Name))</p>}@if(history.Length==0){<p>Aucun booster ouvert.</p>}</details>
}
@if(tab=="Decks"){
@if(deckEditing){<section class="panel"><h2>Construire un deck</h2><label>Nom<input @bind="deckName" maxlength="100" /></label><p>@deckEntries.Values.Sum() / 16 cartes — @(deckEntries.Values.Sum()==16?"Valide":"Incomplet")</p><div class="filters"><label>Rechercher dans la collection<input @bind="deckSearch" @bind:event="oninput" /></label><label>Rareté<select @bind="deckRarity"><option value="-1">Toutes</option>@for(var i=0;i<5;i++){<option value="@i">@rarities[i]</option>}</select></label><label>Type<select @bind="deckType"><option value="-1">Tous</option><option value="0">Personnage</option><option value="1">Action</option></select></label></div><div class="deck-builder">@foreach(var item in collection.Where(x=>x.Quantity>0&&x.Card.Name.Contains(deckSearch,StringComparison.OrdinalIgnoreCase)&&(deckRarity<0||x.Card.Rarity==deckRarity)&&(deckType<0||x.Card.CardType==deckType))){var count=deckEntries.GetValueOrDefault(item.Card.Id);<div><CardView Card="item.Card" Quantity="item.Quantity" /><p>@count dans le deck / @item.Quantity possédés</p><button aria-label="@($"Ajouter {item.Card.Name}")" disabled="@(count>=item.Quantity||deckEntries.Values.Sum()>=16)" @onclick="()=>Adjust(item.Card.Id,1)">+</button><button aria-label="@($"Retirer {item.Card.Name}")" class="secondary" disabled="@(count==0)" @onclick="()=>Adjust(item.Card.Id,-1)">−</button></div>}</div><button disabled="@busy" @onclick="SaveDeck">Enregistrer le deck</button><button class="secondary" @onclick="()=>deckEditing=false">Annuler</button></section>}
else{<h2>Mes decks</h2><button @onclick="()=>EditDeck(null)">Créer un deck</button><div class="tiles">@foreach(var d in decks){<article class="panel"><h3>@d.Name @(d.IsPrimary?"★":"")</h3><p>@d.Cards.Sum(x=>x.Quantity) / 16 cartes · @(d.IsValid?"Valide":"Incomplet")</p><div class="deck-preview">@foreach(var e in d.Cards.Take(3)){var c=cards.FirstOrDefault(x=>x.Id==e.CardId);if(c is not null){<CardView Card="c" />}}</div><button @onclick="()=>EditDeck(d)">Modifier / renommer</button><button class="secondary" disabled="@(busy||d.IsPrimary)" @onclick="()=>Primary(d)">Définir principal</button><button class="secondary" @onclick="()=>deleteDeck=d">Supprimer</button></article>}</div>@if(decks.Length==0){<p class="panel">Aucun deck créé. Vos cartes vous attendent.</p>}}
}
}
@if(detail is not null){<div class="modal-backdrop" @onclick="()=>detail=null"><section class="card-modal" role="dialog" aria-modal="true" aria-label="Détail de la carte" @onclick:stopPropagation="true"><button @onclick="()=>detail=null" autofocus>Fermer ×</button><CardView Card="detail" /></section></div>}
@if(deleteDeck is not null){<section class="panel" role="alertdialog" aria-label="Supprimer le deck"><p>Supprimer « @deleteDeck.Name » ?</p><button disabled="@busy" @onclick="DeleteDeck">Confirmer la suppression</button><button class="secondary" @onclick="()=>deleteDeck=null">Annuler</button></section>}
</div>
@code{
 [Parameter] public RenderFragment? ChildContent { get; set; }
 TcgDto[] mine=[],publics=[];TcgDto? current;CardDto[] cards=[];CollectionItem[] collection=[];DeckDto[] decks=[];OpeningDto[] history=[];CollectionProgressDto progress=new(0,0,0);BoosterStatusDto status=new(0,3,DateTimeOffset.UtcNow);
 bool drawer,loading=true,busy,showAll,editing,deckEditing;string mode="",tab="Collection",tcgName="",tcgDescription="",cover="",code="",publicSearch="",search="",sort="number",deckName="";string deckSearch="";int deckRarity=-1,deckType=-1;int visibility,rarity=-1,type=-1,version,revealed;string? error,invitation,openKey;CardDto? editCard,detail;OpeningDto? opening;DeckDto? deleteDeck;Guid? deckId;Dictionary<Guid,int> deckEntries=[];ElementReference drawerElement;bool focused;
 readonly string[] rarities=["Commune","Peu commune","Rare","Épique","Légendaire"];
 string PathFor(string suffix)=>$"api/tcgs/{current!.Id}/{suffix}";
 IEnumerable<CardDto> Filtered{get{var q=cards.Where(c=>c.Name.Contains(search,StringComparison.OrdinalIgnoreCase)&&(rarity<0||c.Rarity==rarity)&&(type<0||c.CardType==type)&&(tab=="Studio"||showAll||collection.Any(x=>x.Card.Id==c.Id&&x.Quantity>0)));return sort=="name"?q.OrderBy(c=>c.Name):sort=="rarity"?q.OrderByDescending(c=>c.Rarity):q.OrderBy(c=>c.CardNumber);}}
 protected override async Task OnInitializedAsync(){await Run(async()=>{mine=await Auth.Request<TcgDto[]>(HttpMethod.Get,"api/tcgs/mine");if(mine.Length>0)await Select(mine[0]);});loading=false;}
 protected override async Task OnAfterRenderAsync(bool first){if(drawer&&!focused){focused=true;await JS.InvokeVoidAsync("tcgFocus.trap", drawerElement);}if(!drawer)focused=false;}
 void DrawerKey(KeyboardEventArgs e){if(e.Key=="Escape")drawer=false;}
 async Task Run(Func<Task> action){if(busy)return;busy=true;error=null;try{await action();}catch(Exception ex)when(ex is ClientException or HttpRequestException){error=ex.Message;}finally{busy=false;}}
 async Task Select(TcgDto t){drawer=false;current=t;mode="";tab="Collection";search="";rarity=type=-1;invitation=null;editing=deckEditing=false;detail=null;deleteDeck=null;opening=null;openKey=null;await Load();}
 async Task Load(){var v=++version;var id=current?.Id;cards=[];collection=[];decks=[];history=[];progress=new(0,0,0);status=new(0,3,DateTimeOffset.UtcNow);if(id is null)return;loading=true;try{
 var prefix=$"api/tcgs/{id}/";var c=await Auth.Request<CardDto[]>(HttpMethod.Get,prefix+"cards");var co=await Auth.Request<CollectionItem[]>(HttpMethod.Get,prefix+"collection");var d=await Auth.Request<DeckDto[]>(HttpMethod.Get,prefix+"decks");var st=await Auth.Request<BoosterStatusDto>(HttpMethod.Get,prefix+"boosters/status");var h=await Auth.Request<OpeningDto[]>(HttpMethod.Get,prefix+"boosters/history");if(v!=version||current?.Id!=id)return;cards=c;collection=co;decks=d;status=st;history=h;progress=new(co.Count(x=>x.Quantity>0),co.Sum(x=>x.Quantity),co.Length);
 }finally{if(v==version)loading=false;}}
 async Task Reload()=>await Run(async()=>{mine=await Auth.Request<TcgDto[]>(HttpMethod.Get,"api/tcgs/mine");await Load();});
 async Task Action(string action){drawer=false;mode=action;if(action=="discover")await Discover();}
 async Task ChangeTab(string value){tab=value;editing=false;deckEditing=false;await Run(Load);}
 async Task Create()=>await Run(async()=>{var t=await Auth.Request<TcgDto>(HttpMethod.Post,"api/tcgs",new TcgRequest(tcgName,tcgDescription,visibility,string.IsNullOrWhiteSpace(cover)?null:cover));mine=await Auth.Request<TcgDto[]>(HttpMethod.Get,"api/tcgs/mine");await Select(t);});
 async Task JoinCode()=>await Run(async()=>{var prior=mine.Select(x=>x.Id).ToHashSet();await Auth.Command(HttpMethod.Post,"api/tcgs/join-by-code",new JoinCodeRequest(code));mine=await Auth.Request<TcgDto[]>(HttpMethod.Get,"api/tcgs/mine");mode="";var joined=mine.FirstOrDefault(x=>!prior.Contains(x.Id));if(joined is not null)await Select(joined);});
 async Task Discover()=>await Run(async()=>publics=await Auth.Request<TcgDto[]>(HttpMethod.Get,"api/tcgs/public?search="+Uri.EscapeDataString(publicSearch)));
 async Task Join(TcgDto t)=>await Run(async()=>{await Auth.Command(HttpMethod.Post,$"api/tcgs/{t.Id}/join");mine=await Auth.Request<TcgDto[]>(HttpMethod.Get,"api/tcgs/mine");await Select(mine.Single(x=>x.Id==t.Id));});
 async Task Invitation(bool regenerate)=>await Run(async()=>{var r=await Auth.Request<CodeResponse>(regenerate?HttpMethod.Post:HttpMethod.Get,PathFor("invitation")+(regenerate?"/regenerate":""));invitation=r.Code;});
 async Task Status(CardDto c)=>await Run(async()=>{await Auth.Command(HttpMethod.Patch,PathFor($"cards/{c.Id}/status"),new StatusRequest(!c.IsActive));await Load();});
 async Task CardSaved(){editing=false;await Run(Load);}
 async Task Open()=>await Run(async()=>{var id=current!.Id;openKey??=Guid.NewGuid().ToString();var result=await Auth.Request<OpeningDto>(HttpMethod.Post,PathFor("boosters/open"),new OpenBoosterRequest(openKey));if(current?.Id!=id)return;opening=result;openKey=null;revealed=0;await Load();});
 void EditDeck(DeckDto? d){deckEditing=true;deckId=d?.Id;deckName=d?.Name??"Nouveau deck";deckEntries=d?.Cards.ToDictionary(x=>x.CardId,x=>x.Quantity)??[];}
 void Adjust(Guid id,int delta){var count=deckEntries.GetValueOrDefault(id)+delta;if(count<=0)deckEntries.Remove(id);else deckEntries[id]=count;}
 async Task SaveDeck()=>await Run(async()=>{await Auth.Request<DeckDto>(deckId is null?HttpMethod.Post:HttpMethod.Put,PathFor("decks")+(deckId is null?"":$"/{deckId}"),new DeckRequest(deckName,deckEntries.Select(x=>new DeckEntry(x.Key,x.Value)).ToArray()));deckEditing=false;await Load();});
 async Task Primary(DeckDto d)=>await Run(async()=>{await Auth.Command(HttpMethod.Put,PathFor($"decks/{d.Id}/primary"));await Load();});
 async Task DeleteDeck()=>await Run(async()=>{await Auth.Command(HttpMethod.Delete,PathFor($"decks/{deleteDeck!.Id}"));deleteDeck=null;await Load();});
 sealed record CodeResponse(string Code);
}
