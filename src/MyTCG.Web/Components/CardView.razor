@using MyTCG.Contracts
@inject MyTCG.Client.AuthClient Auth
<article class="tcg-card rarity-@Card.Rarity @(Locked ? "locked" : "")" aria-label="@Card.Name">
 <div class="card-illustration">@if(image is not null){<img src="@image" alt="" loading="lazy" referrerpolicy="no-referrer" />}else{<span aria-hidden="true">✦</span>}<b class="card-cost">@Card.ActionCost</b></div>
 <div class="card-copy"><small>#@Card.CardNumber · @Rarities[Card.Rarity]</small><h3>@Card.Name</h3><p>@(Card.CardType==0?"Personnage":"Action") @if(Card.CardType==0){<span> · ⚔ @Card.Attack / ◇ @Card.Defense</span>}</p><p>@Card.Description</p>@if(Quantity is not null){<strong>@(Locked?"Non découverte":$"× {Quantity}")</strong>}@if(!Card.IsActive){<small>Archivée</small>}</div>
</article>
@code {
 [Parameter,EditorRequired] public CardDto Card {get;set;}=null!;
 [Parameter] public int? Quantity {get;set;}
 [Parameter] public bool Locked {get;set;}
 private string? image, previous;
 private static readonly string[] Rarities=["Commune","Peu commune","Rare","Épique","Légendaire"];
 protected override async Task OnParametersSetAsync(){if(previous==Card.ImageUrl)return;previous=Card.ImageUrl;image=null;try{var target=previous;var result=await Auth.Image(target);if(previous==target)image=result;}catch(MyTCG.Client.ClientException){}}
}
