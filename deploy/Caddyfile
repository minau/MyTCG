{$WEB_DOMAIN} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    handle /api/* {
        reverse_proxy api:8080
    }
    handle {
        reverse_proxy web:8080
    }
}
{$API_DOMAIN} {
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy api:8080
}
